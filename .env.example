# Set these on Vercel → Project → Settings → Environment Variables.
# DO NOT commit a real .env file (it is in .gitignore).

# Used by the serverless functions in /api/admin/ to write to Supabase.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Hardcoded admin password — anyone with this can update match results.
ADMIN_PASSWORD=change-me
